 *
 * Problem Statement:
 * Implement a Queue ADT using an array and a class in C++.
 * The program performs the following operations:
 *   1. Enqueue - insert an element at the rear of the queue
 *   2. Dequeue - delete an element from the front of the queue
 *   3. Display - show all elements from front to rear
 *
 * Features:
 *   - Fixed capacity of 5 elements
 *   - Overflow check ("Queue is Full")
 *   - Underflow check ("Queue is Empty")
 *   - Follows the FIFO (First In, First Out) principle
 *
 * Working of main():
 *   - Reads 5 elements from the user and enqueues them
 *   - Displays the queue
 *   - Dequeues one element (front) and displays the queue again
 * ============================================================
 */

#include <iostream>
using namespace std;

class Pract
{
private:
    int queue[5];
    int front, rear, size;

public:
    Pract()
    {
        size = 5;
        front = rear = -1;
    }

    // Insert element at rear (Enqueue)
    void enqueue(int value)
    {
        if (rear == size - 1)
        {
            cout << "Queue is Full\n";
            return;
        }

        if (front == -1)
            front = 0;

        queue[++rear] = value;
        cout << value << " inserted\n";
    }

    // Delete element from front (Dequeue)
    void dequeue()
    {
        if (front == -1 || front > rear)
        {
            cout << "Queue is Empty\n";
            return;
        }

        cout << "Deleted Element: " << queue[front] << endl;
        front++;

        if (front > rear)
            front = rear = -1;
    }

    // Display queue elements
    void display()
    {
        if (front == -1)
        {
            cout << "Queue is Empty\n";
            return;
        }

        cout << "Queue Elements: ";
        for (int i = front; i <= rear; i++)
        {
            cout << queue[i] << " ";
        }
        cout << endl;
    }
};

int main()
{
    Pract q;
    int value;

    cout << "Enter 5 elements:\n";
    for (int i = 0; i < 5; i++)
    {
        cin >> value;
        q.enqueue(value);
    }

    q.display();

    q.dequeue();

    q.display();

    return 0;
}
