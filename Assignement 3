 *
 * Problem Statement:
 * Implement a Singly Linked List in C++ using a struct and dynamic
 * memory allocation. The program performs the following operations:
 *   1. Insert at Beginning - add a new node at the head of the list
 *   2. Insert at End       - add a new node at the tail of the list
 *   3. Delete from Beginning - remove the first node of the list
 *   4. Display             - traverse and print all nodes
 *
 * Features:
 *   - Each node stores an integer (data) and a pointer (next)
 *   - Empty list check ("List is empty")
 *   - Memory freed using delete when a node is removed
 *
 * Working of main():
 *   - Inserts 101 and 102 at the beginning, then 103 and 104 at the end
 *   - Displays the list: 102 -> 101 -> 103 -> 104 -> NULL
 *   - Deletes from the beginning and displays again:
 *     101 -> 103 -> 104 -> NULL
 * ============================================================
 */

#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

Node* head = NULL;

// Insert at beginning
void insertBeginning(int value)
{
    Node* newNode = new Node();
    newNode->data = value;
    newNode->next = head;
    head = newNode;
}

// Insert at end
void insertEnd(int value)
{
    Node* newNode = new Node();
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL)
    {
        head = newNode;
        return;
    }

    Node* temp = head;

    while (temp->next != NULL)
    {
        temp = temp->next;
    }

    temp->next = newNode;
}

// Delete from beginning
void deleteBeginning()
{
    if (head == NULL)
    {
        cout << "List is empty" << endl;
        return;
    }

    Node* temp = head;
    head = head->next;
    delete temp;
}

// Display
void display()
{
    if (head == NULL)
    {
        cout << "List is empty" << endl;
        return;
    }

    Node* temp = head;

    while (temp != NULL)
    {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL" << endl;
}

int main()
{
    insertBeginning(101);
    insertBeginning(102);

    insertEnd(103);
    insertEnd(104);

    cout << "Linked List: ";
    display();

    cout << "After deleting from beginning: ";
    deleteBeginning();
    display();

    return 0;
}
